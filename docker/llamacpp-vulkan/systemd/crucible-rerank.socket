[Unit]
Description=Crucible GPU reranker (on-demand socket)
Documentation=file:///home/_shared_code/obsidian-crucible/docker/llamacpp-vulkan/systemd/README.md

[Socket]
# This is the port Crucible is configured against. Nothing should point at the container's
# published port (14805) directly -- that would bypass the on-demand start entirely and hit a
# stopped container.
ListenStream=127.0.0.1:4805
# Accept=no: one long-lived proxy process handles every connection, which is what allows a
# single idle timer to govern the whole service. Accept=yes would fork per connection and there
# would be no "idle" to measure.
Accept=no

[Install]
WantedBy=sockets.target
