#!/usr/bin/env bash
# Bring one GPU inference container up (and wait until it can actually answer) or take it down.
#
# This exists because socket activation and containers disagree about what "started" means.
# systemd considers ExecStartPre finished when the command exits, and `docker compose up -d`
# exits as soon as the container is *created* — long before llama.cpp has mapped a 1.2GB GGUF
# onto the GPU. Without the wait, systemd-socket-proxyd would connect to a port nothing is
# listening on yet and the first request after every idle period would fail rather than being
# slow. So `up` blocks on /health.
set -uo pipefail

COMPOSE_FILE="${CRUCIBLE_COMPOSE_FILE:-/home/_shared_code/context-control/compose.home.yml}"
# How long to allow for container create + model load. Generous on purpose: the cost of waiting
# too long is a slow first request, the cost of waiting too little is a failed one.
READY_TIMEOUT="${CRUCIBLE_READY_TIMEOUT:-120}"

usage() {
	echo "usage: $(basename "$0") up|down <compose-service> [host-port]" >&2
	exit 2
}

[ $# -ge 2 ] || usage
action="$1"
service="$2"
port="${3:-}"

case "$action" in
	up)
		[ -n "$port" ] || usage
		# Naming the service explicitly is what enables its `gpu-inference` profile; without the
		# name compose would consider it out of scope and do nothing at all, silently.
		if ! docker compose -f "$COMPOSE_FILE" up -d "$service"; then
			echo "crucible-inference-ctl: compose failed to start $service" >&2
			exit 1
		fi
		deadline=$(( $(date +%s) + READY_TIMEOUT ))
		until curl -fsS --max-time 2 "http://127.0.0.1:${port}/health" >/dev/null 2>&1; do
			if [ "$(date +%s)" -ge "$deadline" ]; then
				echo "crucible-inference-ctl: $service did not become healthy within ${READY_TIMEOUT}s" >&2
				# The logs are the only place the entrypoint's GPU assertion is visible, and a
				# refusal to start on llvmpipe looks identical to a slow load from out here.
				docker logs --tail 40 "$service" >&2 2>/dev/null || true
				exit 1
			fi
			sleep 1
		done
		;;
	down)
		# `stop`, not `down`: `down` would tear down the whole compose project's networks and any
		# other service sharing them. This unit owns one container, so it stops one container.
		docker compose -f "$COMPOSE_FILE" stop "$service" >/dev/null 2>&1 || true
		;;
	*)
		usage
		;;
esac
