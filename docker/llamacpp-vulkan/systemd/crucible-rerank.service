[Unit]
Description=Crucible GPU reranker (llama.cpp Vulkan, on-demand)
Documentation=file:///home/_shared_code/obsidian-crucible/docker/llamacpp-vulkan/systemd/README.md
Requires=crucible-rerank.socket
After=crucible-rerank.socket

[Service]
# Starts the container and blocks until it answers /health -- see the helper's header for why
# "docker compose up -d returned" is not the same as "ready".
ExecStartPre=/home/_shared_code/obsidian-crucible/docker/llamacpp-vulkan/systemd/crucible-inference-ctl up crucible-rerank-gpu 14813
# The proxy is the unit's main process, so when it exits on idle the service stops and
# ExecStopPost puts the container away. --exit-idle-time is therefore the whole idle policy.
#
# 30min, not 5: the cost of an expired timer is a cold start on the next search (container start
# plus a GGUF load), and Crucible's interactive client gives health and search only 5 seconds
# before it declares the companion unreachable. A working session should not pay that more than
# once, while an idle desktop still gets its VRAM back well before anyone sits down to a game.
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --exit-idle-time=30min 127.0.0.1:14813
ExecStopPost=/home/_shared_code/obsidian-crucible/docker/llamacpp-vulkan/systemd/crucible-inference-ctl down crucible-rerank-gpu
# The container outlives any single proxy restart, so a failed proxy should not thrash it.
Restart=no
