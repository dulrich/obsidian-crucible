{
	"name": "obsidian-crucible",
	"version": "1.0.0",
	"description": "An agentic second brain for Obsidian. Orchestrate your workflows, capture your reading, and synthesize insights.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --test tests/*.test.mjs",
		"search:serve": "node scripts/search-companion.mjs",
		"search:snapshot": "bash scripts/search-snapshot.sh",
		"search:agreement": "node scripts/embedding-agreement.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . && stylelint \"**/*.css\""
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint-formatter-codeframe": "^7.32.2",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"stylelint": "^17.9.0",
		"stylelint-config-standard": "^40.0.0",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1"
	},
	"dependencies": {
		"obsidian": "latest"
	}
}
