# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json
vault
.crucible/

# Search index snapshots. scripts/search-snapshot.sh defaults to writing
# ./search-backup-<date>.sqlite in the current directory, which is ~385MB
# against the live index — never something to commit.
search-backup-*.sqlite

# Exclude macOS Finder (System Explorer) View States
.DS_Store


# local python/terminal history
.cond.pyhistory
# Swap files
*.swp

# Agent Local Configs
.codex
.claude/
.gemini/
.cursor/
.continue/
.windsurf/
.cline/
.roo/
.roocode/
.aider*
.augment/
.qwen/
.kiro/
.opencode/
.crush/
CLAUDE.local.md
GEMINI.local.md

# Measurement artifacts — archived in eval-harness/local-inference-bench,
# scrubbed from this repo's history 2026-07-26. Never commit run data here.
runs/
search-query-log.json
# The dev vault's plugin dir is a symlink to this repo, so plugin-data writes (the
# image-description store) land in the working tree. Vault-derived text — same
# public-repo hazard as runs/. Never commit it.
image-descriptions/
